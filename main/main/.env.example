# Скопируйте в .env рядом с manage.py и заполните. Файл .env не попадает в git.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=book.auezov.edu.kz,www.book.auezov.edu.kz,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://book.auezov.edu.kz,https://www.book.auezov.edu.kz
